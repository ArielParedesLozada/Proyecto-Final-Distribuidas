{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "eureka": {
    "client": {
      "serviceUrl": {
        "defaultZone": "http://localhost:8761/eureka"
      },
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true
    },
    "instance": {
      "appName": "FUEL-SERVICE",
      "hostName": "localhost",
      "port": "5127",
      "preferIpAddress": true,
      "metadataMap": {
        "httpPort": 5126,
        "grpcPort": 5127
      }
    }
  }
}